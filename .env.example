# === Required ===
OPENAI_API_KEY=sk-...

# === Optional but recommended ===
YOUTUBE_API_KEY=AIza...

# === Carrossel diário — banco de imagens gratuito ===
# Chave grátis em https://www.pexels.com/api/ (200 req/hora, 20.000/mês)
# Sem PEXELS_API_KEY o carrossel ainda é gerado, só fica sem fotos baixadas.
PEXELS_API_KEY=

# === OpenAI Settings ===
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# === Agent Settings ===
MAX_IDEAS=10
# Regions for YouTube and Google Trends collection
REGIONS=BR,US

# === Storage ===
DB_PATH=data/trends.db

# === Email (Gmail recomendado) ===
# Desativado por padrão. Coloque EMAIL_ENABLED=true para reativar o envio.
# Use uma "Senha de app" do Gmail — não a senha normal
# Gere em: myaccount.google.com → Segurança → Senhas de app
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=seu@gmail.com
EMAIL_TO=destino@email.com,outro@email.com

# === API Server (Render/Railway) ===
PORT=8000
HOST=0.0.0.0

# === Notas sobre fontes ===
# Reddit:   API pública gratuita, sem credenciais necessárias
# TikTok:   Creative Center API pública (sem garantias de disponibilidade)
# YouTube:  Requer YOUTUBE_API_KEY para coleta de vídeos em alta
# Instagram: Sem API pública gratuita — não suportado
