# === Required ===
OPENAI_API_KEY=sk-...

# === Optional but recommended ===
YOUTUBE_API_KEY=AIza...

# === OpenAI Settings ===
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# === Agent Settings ===
MAX_IDEAS=10
REGIONS=BR,US

# === Storage ===
DB_PATH=data/trends.db

# === API Server (Render/Railway) ===
PORT=8000
HOST=0.0.0.0
